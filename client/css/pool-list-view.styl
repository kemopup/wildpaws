@import colors

.pool-list
    ul
        list-style-type: none
        padding: 0
        display: flex
        align-content: flex-end
        flex-wrap: wrap
        margin: 0 -0.25em
        

        li
            flex-direction: column
            align-items: center
            position: relative
            flex-grow: 0
            margin: 2em 1.5em 2em 1.2em
            display: inline-block
            text-align: left
            min-width: 12em
            width: clamp(12em, 16vw, 16em)
            &.flexbox-dummy
                display: none

            .thumbnail-wrapper
                position: relative
                display: block
                width: 100%
                aspect-ratio: 7 / 5
                outline: none

            .thumbnail
                box-sizing: border-box
                width: calc(100% - 24px)
                height: calc(100% - 24px)
                border: 2px solid #ddd
                outline-offset: -2px
                background-color: $window-color
                background-size: cover
                background-position: 50% 30%
                position: absolute
                display: inline-block
                box-shadow: 0 1px 5px rgba(0,0,0,0.65)

            .thumbnail-1, .thumbnail.empty
                left: 0
                top: 24px
                z-index: 30

            .thumbnail-2
                left: 12px
                top: 12px
                z-index: 20

            .thumbnail-3
                left: 24px
                top: 0
                z-index: 10

            .thumbnail.empty
                background-size: 20px 20px

            .pool-name
                color: black
                font-size: 1em
                text-align: center
                font-weight: bold
                margin-top: 0.6em
                overflow-wrap: anywhere
                a
                    width: 100%
                    display: inline-block

            a:active, a:focus
                .thumbnail
                    outline: 2px solid $main-color !important

.pool-list .thumbnail-wrapper:hover,
.pool-list .thumbnail-wrapper:focus-visible
    .thumbnail
        outline: 2px solid $main-color

.pool-list-header
    label
        display: none !important
    text-align: left
    form
        width: auto
    input[name=search-text]
        width: 25em
        @media (max-width: 1000px)
            width: 100%
    .append
        vertical-align: middle
        font-size: 0.95em
        color: $inactive-link-color

.darktheme .pool-list-header
    .append
        color: $inactive-link-color-darktheme
