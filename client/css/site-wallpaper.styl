@import colors

#settings
    width: 100%
    max-width: 44em

    form
        width: 100%

    .site-wallpaper-settings
        margin-bottom: 1.5em
        padding-bottom: 1.5em
        border-bottom: 1px solid $line-color

.post-view .site-wallpaper
    margin-top: 1em

    a[aria-disabled='true']
        color: $inactive-link-color
        cursor: progress
